{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "update-plan.schema.json",
  "title": "Workstation Update Plan",
  "description": "Read-only, ordered list of updates one PC needs, built from one normalized audit report and config/workstation.policy.json. Nothing in a plan is executed. Shareable like evaluation output: it never contains absolute paths, commit IDs, remote URLs, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditSchemaMajor",
    "policy",
    "report",
    "summary",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "auditSchemaMajor": {
      "type": "integer",
      "const": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "digest"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "digest": {
          "description": "SHA-256 of the policy file's bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "report": {
      "$ref": "#/$defs/endpoint"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionCount",
        "lowRiskCount",
        "mediumRiskCount",
        "highRiskCount",
        "reversibleCount",
        "manualCount"
      ],
      "properties": {
        "actionCount": {
          "type": "integer",
          "minimum": 0
        },
        "lowRiskCount": {
          "type": "integer",
          "minimum": 0
        },
        "mediumRiskCount": {
          "type": "integer",
          "minimum": 0
        },
        "highRiskCount": {
          "type": "integer",
          "minimum": 0
        },
        "reversibleCount": {
          "type": "integer",
          "minimum": 0
        },
        "manualCount": {
          "description": "Actions without a command, which need the operator.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "actionId",
        "kind",
        "source",
        "componentId",
        "subjectId",
        "title",
        "currentVersion",
        "targetVersion",
        "command",
        "risk",
        "reversible",
        "message",
        "evidence"
      ],
      "properties": {
        "order": {
          "description": "1-based position; actions run in this order.",
          "type": "integer",
          "minimum": 1
        },
        "actionId": {
          "description": "Stable identity of the action, for example winget-upgrade:Git.Git or policy:path.allowMissingEntries.",
          "type": "string",
          "pattern": "^[a-z]+(?:-[a-z]+)*:[0-9A-Za-z][0-9A-Za-z._+-]*$"
        },
        "kind": {
          "description": "upgrade: newer version of something installed. install: something the policy requires is missing. configure: settings such as environment variables. cleanup: remove broken or duplicate state.",
          "type": "string",
          "enum": [
            "upgrade",
            "install",
            "configure",
            "cleanup"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "policyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "policy",
                "winget"
              ]
            },
            "policyKey": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:\\.[a-zA-Z][a-zA-Z0-9]*)+$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "policy"
                  }
                }
              },
              "then": {
                "properties": {
                  "policyKey": {
                    "type": "string"
                  }
                }
              },
              "else": {
                "properties": {
                  "policyKey": {
                    "const": null
                  }
                }
              }
            }
          ]
        },
        "componentId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "subjectId": {
          "description": "Path-safe identity when one action targets a sub-subject, such as winget:<packageId> or project:<hash>.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]+:[0-9A-Za-z][0-9A-Za-z._+-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "currentVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "targetVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "command": {
          "description": "The exact command that would run, without user-specific paths. null when the action needs the operator.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "risk": {
          "description": "low: routine and isolated. medium: may affect projects or other tools. high: migration or removal that is hard to undo.",
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reversible": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "generatedAt",
        "audit",
        "host"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "toolVersion"
          ],
          "properties": {
            "mode": {
              "const": "read-only"
            },
            "toolVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "platform",
            "architecture"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "componentId",
        "evidenceId"
      ],
      "properties": {
        "providerId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "componentId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "evidenceId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        }
      }
    }
  }
}
