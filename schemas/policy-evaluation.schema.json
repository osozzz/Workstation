{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-evaluation.schema.json",
  "title": "Workstation Policy Evaluation",
  "description": "Read-only evaluation of one normalized audit report against config/workstation.policy.json. Shareable like comparison output: it never contains absolute paths, commit IDs, remote URLs, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "auditSchemaMajor", "policy", "report", "summary", "findings"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "auditSchemaMajor": { "type": "integer", "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "digest"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.0" },
        "digest": {
          "description": "SHA-256 of the policy's canonical JSON, so two evaluations can be tied to the same policy.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "report": { "$ref": "#/$defs/endpoint" },
    "summary": { "$ref": "#/$defs/summary" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "audit", "host"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "toolVersion"],
          "properties": {
            "mode": { "const": "read-only" },
            "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "platform", "architecture"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findingCount", "compliantCount", "deviationCount", "unknownCount", "notEvaluableCount"],
      "properties": {
        "status": {
          "description": "deviations when any finding deviates; incomplete when none deviate but some are unknown; compliant otherwise.",
          "type": "string",
          "enum": ["compliant", "deviations", "incomplete"]
        },
        "findingCount": { "type": "integer", "minimum": 0 },
        "compliantCount": { "type": "integer", "minimum": 0 },
        "deviationCount": { "type": "integer", "minimum": 0 },
        "unknownCount": { "type": "integer", "minimum": 0 },
        "notEvaluableCount": { "type": "integer", "minimum": 0 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "policyKey", "status", "componentId", "subjectId", "expected", "observed", "message", "evidence"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "policyKey": {
          "description": "Dotted path of the policy setting this finding evaluates, for example node.defaultTrack.",
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*(?:\\.[a-zA-Z][a-zA-Z0-9]*)+$"
        },
        "status": {
          "description": "compliant: evidence meets the policy. deviation: evidence contradicts it. unknown: evidence that could decide it is missing or unavailable in this report. not-evaluable: the audit never collects evidence for this setting.",
          "type": "string",
          "enum": ["compliant", "deviation", "unknown", "not-evaluable"]
        },
        "componentId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
        "subjectId": {
          "description": "Path-safe identity when one rule yields several findings, such as project:<hash>.",
          "type": ["string", "null"],
          "pattern": "^[a-z]+:[0-9a-z.-]+$"
        },
        "expected": { "$ref": "#/$defs/value" },
        "observed": { "$ref": "#/$defs/value" },
        "message": { "type": "string", "minLength": 1 },
        "evidence": {
          "description": "Where in the audit report the decision came from.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["providerId", "componentId", "evidenceId"],
            "properties": {
              "providerId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
              "componentId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
              "evidenceId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not-evaluable" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "const": null }, "evidence": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["compliant", "deviation"] } }, "required": ["status"] },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "value": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } }
      ]
    }
  }
}
