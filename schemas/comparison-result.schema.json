{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison-result.schema.json",
  "title": "Workstation Comparison Result",
  "description": "Normalized, read-only reference-to-target comparison result for two Workstation audit reports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "auditSchemaMajor",
    "direction",
    "reference",
    "target",
    "summary",
    "differences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "auditSchemaMajor": {
      "const": 1
    },
    "direction": {
      "const": "reference-to-target"
    },
    "reference": {
      "$ref": "#/$defs/endpoint"
    },
    "target": {
      "$ref": "#/$defs/endpoint"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "differences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/difference"
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "generatedAt",
        "audit",
        "host"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "toolVersion"
          ],
          "properties": {
            "mode": {
              "const": "read-only"
            },
            "toolVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "platform",
            "architecture"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "differenceCount",
        "providerDifferenceCount",
        "componentDifferenceCount",
        "unavailableCount",
        "unknownCount",
        "notApplicableCount"
      ],
      "properties": {
        "status": {
          "enum": [
            "equal",
            "different"
          ]
        },
        "differenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "providerDifferenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "componentDifferenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "unavailableCount": {
          "type": "integer",
          "minimum": 0
        },
        "unknownCount": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicableCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "kind",
        "providerId",
        "componentId",
        "subjectId",
        "relation",
        "referenceState",
        "targetState",
        "referenceValue",
        "targetValue"
      ],
      "properties": {
        "category": {
          "enum": [
            "provider",
            "component",
            "version",
            "path",
            "environment",
            "application",
            "project",
            "git"
          ]
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "providerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "componentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation": {
          "enum": [
            "reference-only",
            "target-only",
            "different",
            "unavailable",
            "unknown",
            "not-applicable"
          ]
        },
        "referenceState": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetState": {
          "type": [
            "string",
            "null"
          ]
        },
        "referenceValue": {
          "$ref": "#/$defs/scalar"
        },
        "targetValue": {
          "$ref": "#/$defs/scalar"
        }
      }
    }
  }
}
